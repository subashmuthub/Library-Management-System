# Backend API Configuration
VITE_API_URL=/api/v1

# Google Sign-In (Web OAuth client ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Application Mode (true = DEMO with handheld readers, false = PRODUCTION with fixed readers)
VITE_DEMO_MODE=true

# GPS Configuration
VITE_LIBRARY_LATITUDE=37.7749
VITE_LIBRARY_LONGITUDE=-122.4194
VITE_GPS_PROXIMITY_THRESHOLD=50